[Unit]
Description=SuAn Pharmacy V2 backend
After=network.target mysql.service redis-server.service rabbitmq-server.service

[Service]
Type=simple
User=pharmacy
Group=pharmacy
EnvironmentFile=/etc/pharmacy/pharmacy.env
WorkingDirectory=/opt/pharmacy
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=70 -jar /opt/pharmacy/pharmacy-delivery-backend.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pharmacy/prescriptions /var/log/pharmacy
StandardOutput=append:/var/log/pharmacy/application.log
StandardError=append:/var/log/pharmacy/application.log

[Install]
WantedBy=multi-user.target
