DB_URL=jdbc:mysql://127.0.0.1:3306/pharmacy_delivery?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=pharmacy_app
DB_PASSWORD=replace-with-a-secret
JWT_SECRET=replace-with-at-least-32-random-bytes
REDIS_HOST=127.0.0.1
RABBITMQ_HOST=127.0.0.1
RABBITMQ_USERNAME=pharmacy_app
RABBITMQ_PASSWORD=replace-with-a-secret
REFRESH_COOKIE_SECURE=true
PRESCRIPTION_STORAGE_PATH=/var/lib/pharmacy/prescriptions
MESSAGING_ENABLED=true
EVENT_GAUGE_REFRESH_MS=30000
# Prometheus should scrape 127.0.0.1:8089/actuator/prometheus via private path only.
